# Twitch Developer App credentials
# 1. Create your app at https://dev.twitch.tv/console
# 2. Set the OAuth redirect URI to: http://localhost:3000
# 3. Run `npm run auth` to complete the OAuth flow and get your tokens
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Generated by running: npm run auth
ACCESS_TOKEN=
REFRESH_TOKEN=

# Your Twitch numeric user ID — printed by auth.js after successful login
BROADCASTER_ID=
SENDER_ID=

# OBS WebSocket (Tools → WebSocket Server Settings in OBS)
# Leave OBS_WS_PASSWORD blank if you haven't set a password in OBS.
OBS_WS_PORT=4455
OBS_WS_PASSWORD=

# Name of your mic audio input source in OBS (used by the MIC key).
# Check Audio Mixer in OBS — hover over the mic fader to see the exact name.
OBS_MIC_SOURCE=Mic/Aux
